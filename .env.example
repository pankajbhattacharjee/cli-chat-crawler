# AI Provider Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Provider: auto, gemini, anthropic, rules
LLM_PROVIDER=auto

# Crawler Limits
MAX_PAGES_CAP=30
MAX_DEPTH_CAP=2
CRAWL_TIME_BUDGET_SEC=45

# Rate Limits
RATE_LIMIT_PER_MIN=12
MAX_REQUESTS_PER_DAY=300
MAX_CONCURRENT_CRAWLS=2

# Security
DEV_ALLOW_PRIVATE_HOSTS=0
# AWS S3 Storage
S3_ENABLED=0
S3_BUCKET=
AWS_REGION=ap-south-1